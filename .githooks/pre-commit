#!/bin/sh
# Refuse to commit anything that looks like a credential or a device/network identifier.
# Enable with:  git config core.hooksPath .githooks
bad=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v '^+++' | grep -i -E \
  -e 'BEGIN [A-Z ]*PRIVATE KEY' \
  -e 'ssh-(ed25519|rsa|ecdsa)[a-z0-9-]* AAAA' \
  -e '192\.168\.[0-9]+\.[0-9]+' \
  -e '(^|[^0-9A-Fa-f:])([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}([^0-9A-Fa-f:]|$)' \
  -e '(password|passwd|secret|token)[A-Za-z_]*["'\'']?[ ]*[=:][ ]*["'\''][^"'\'']{6,}["'\'']' \
  -e '^\+[ \t]*(password|passwd|secret|token)[A-Za-z_]*[ ]*=[^ ]{6,}' \
  | grep -v -E '00:00:00:00:00:00|192\.168\.x\.x|xx:xx:xx:xx:xx:xx')
if [ -n "$bad" ]; then
  echo "pre-commit: possible credential or identifier in staged changes:" >&2
  echo "$bad" | cut -c1-140 >&2
  echo "Remove it (or bypass deliberately with --no-verify)." >&2
  exit 1
fi
